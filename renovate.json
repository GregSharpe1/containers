{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "schedule": ["before 9am on monday"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anomalyco/opencode"],
      "labels": ["opencode"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["opencode/Dockerfile"],
      "matchStrings": [
        "ARG KUBECTL_VERSION=v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "kubernetes/kubectl",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "fileMatch": ["opencode/Dockerfile"],
      "matchStrings": [
        "ARG GH_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cli/cli",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
