{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "schedule": ["before 9am on monday"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anomalyco/opencode"],
      "labels": ["opencode"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine", "library/alpine"],
      "enabled": false
    }
  ]
}
